flowchart TB
    USER["玩家：提示词 + 可选截图"]
    API["D · API + Runtime<br/>鉴权、任务、预算、幂等、SSE、取消"]
    subgraph INPUT["输入层 · UserInput 多模态处理链路"]
        INGRESS["D · 接入校验<br/>字段、幂等、附件归属"]
        TEXT["G · 文本抽取<br/>请求候选、状态陈述、实体"]
        VISION["G · 视觉抽取<br/>物品、数量、区域、未知项"]
        FUSION["D · 跨模态融合与校验<br/>指代绑定、Schema、来源、覆盖"]
        PARSED["D · ParsedInput<br/>请求候选 + 状态候选 + evidence + unknowns"]
        INGRESS --> TEXT
        INGRESS --> VISION
        TEXT --> FUSION
        VISION --> FUSION
        FUSION --> PARSED
    end
    subgraph UNDERSTAND["理解层：CoachTaskRepresentation 生成与路由"]
        U_PARSE["D · ParsedInput 校验<br/>输入版本、引用和 unknowns"]
        U_INTENT["G · 意图识别<br/>目标、子目标、实体候选"]
        U_STATE["D · 状态解析与合并<br/>scope / revision / TTL / 冲突"]
        STATE["D · CoachTaskRepresentation<br/>意图、约束、目标、状态、证据、不确定性"]
        U_QUERY["D · KnowledgeQuery<br/>实体 / 背景 / 能力缺口"]
        U_ROUTE["D · 请求路由门禁<br/>知识 / 计算 / 决策 / 澄清"]
        U_CLARIFY["D · 澄清与重理解<br/>新 revision · 保留未失效成果"]
        U_PARSE --> U_INTENT
        U_PARSE --> U_STATE
        U_INTENT --> STATE
        U_STATE --> STATE
        STATE --> U_QUERY
        U_QUERY --> STATE
        STATE --> U_ROUTE
        U_ROUTE --> U_CLARIFY
        U_CLARIFY --> STATE
    end
    ASK["D · 共享澄清能力<br/>各图本地 clarify → interrupt → resume<br/>校验补充信息、按依赖失效、恢复原任务"]

    subgraph SIMPLE["决策层 · SimpleCall 简单调用链路"]
        SLOTS["D · 输入规范化 / 槽位校验"]
        PORTS["D · CalculatorPort<br/>raid.calculate / craft.plan_gap<br/>not_configured：明确不可用"]
        SIMPLE_VERIFY["D · 结果校验<br/>单位、范围、版本、provenance"]
        SIMPLE_RESULT["D · DecisionResult<br/>CalculationResult / unavailable / needs_input"]
        SLOTS --> PORTS
        PORTS --> SIMPLE_VERIFY
        SIMPLE_VERIFY --> SIMPLE_RESULT
    end

    subgraph PE["Plan-and-Execute 决策子图"]
        PREP["D · prepare_decision"]
        PLAN["G · Planner"]
        CHECK["D · validate_plan / select_next_step"]
        EXEC["D · Executor<br/>允许操作、参数、依赖和预算"]
        ACTION["D · evaluate_actions<br/>前置条件、资源条件、行动取舍"]
        VERIFY["D · verify_step / assess_progress"]
        REPLAN["G · Replanner<br/>仅修改未完成或失效步骤"]
        FINALIZE["D · finalize_decision<br/>TaskSolution / DecisionResult：verified / conditional / blocked"]
    end

    subgraph RAG["Agentic RAG 子图 · 决策证据"]
        QUERY["G · 查询规划 / 改写"]
        SOURCES["D · 来源选择 / 时效策略"]
        VECTOR["D · vector_retrieve<br/>语义 + metadata + 关键词"]
        WEB["D · web_search → web_fetch<br/>实时发现、正文、时间、hash"]
        NORMAL["D · 去重 / 适用性检查"]
        GRADE["G · 证据相关 / 支持 / 反驳"]
        COVER["D · 覆盖 / 冲突 / 时效 / 预算门禁"]
        BUNDLE["D · EvidenceBundle<br/>声明-证据矩阵、缺口、冲突"]
    end

    subgraph KNOW["知识层：存储、索引、记忆与发布"]
        INGEST["D · 来源审核 / 分块 / embedding / 关系抽取 / 发布<br/>模型抽取候选须审核"]
        KDB[("S · 结构化知识库<br/>事实 / 规则 / 行动 / capability<br/>kb_release")]
        VDB[("S · 向量数据库<br/>chunks / embeddings / metadata<br/>embedding_version")]
        KG[("S · 知识图谱〔规划〕<br/>实体 / 关系 / 来源 / graph_release")]
        SNAP[("S · 实时正文快照<br/>web_snapshot / live_checked_at")]
        WM[("S · 工作记忆<br/>TaskState / checkpoint / EvidenceNeed")]
        EM[("S · 情景记忆<br/>玩家事件 / 结果 / scope / TTL")]
        SM[("S · 语义记忆<br/>偏好 / 习惯 / 学习进度 / 遗忘")]
    end

    subgraph PERSIST["Task State / Persistence"]
        CP[("S · PostgreSQL Checkpointer<br/>主图和静态子图；任务级恢复")]
        PLAYER[("S · 玩家状态 / 会话<br/>独立范围、revision、TTL")]
        RESULTS[("S · 结果 / 预算账本 / outbox")]
    end

    SPEC["D · AnswerSpec<br/>结果、状态、断言、必需区块与来源"]
    ASSERT["D · 受保护断言 / 区块校验<br/>数字、候选、条件、引用、回执"]
    OUTPUT["D · AnswerEnvelope / 输出门禁<br/>模板渲染、隐私、注入、状态保护"]
    STYLE["G · 人设叙述槽位<br/>只组织已支持声明，不新增事实"]
    FALLBACK["D · 确定性回退<br/>澄清 / partial / error，不补造结论"]
    OBS["D · Trace / Metrics / Eval / Badcase<br/>输入、检索、决策、生成、延迟、成本 → 发布门禁"]

    USER --> API
    API -->|prompt + attachment_ids| INGRESS
    PARSED -->|统一结构化结果| U_PARSE
    PLAYER -->|当前状态上下文| U_STATE
    EM -->|历史事件上下文| U_STATE
    SM -->|偏好与学习上下文| U_STATE
    STATE -->|关键缺口| ASK
    STATE -->|简单强计算| SLOTS
    STATE -->|普通聊天直达| SPEC
    SLOTS -->|完整且能力匹配| PORTS
    SLOTS -->|缺字段| ASK
    SIMPLE_RESULT -->|结构化结果| SPEC
    STATE -->|决策建议| PREP
    PREP --> PLAN
    PLAN --> CHECK
    CHECK -->|ready step| EXEC
    CHECK -->|缺输入| ASK
    EXEC -->|EvidenceNeed| QUERY
    EXEC -->|两类计算| PORTS
    PORTS -->|StepResult| VERIFY
    EXEC -->|候选行动| ACTION
    ACTION --> VERIFY
    VERIFY -->|还有步骤| CHECK
    VERIFY -->|剩余计划不适用| REPLAN
    REPLAN --> CHECK
    VERIFY -->|中途缺输入| ASK
    VERIFY -->|完成或明确部分结果| FINALIZE
    FINALIZE --> SPEC
    STATE -->|KnowledgeQuery| QUERY

    QUERY --> SOURCES
    SOURCES -->|exact / rules / capability| KDB
    SOURCES -->|relations / multi-hop| KG
    SOURCES -->|player history / preference| EM
    SOURCES -->|task context / prior evidence| WM
    SOURCES -->|vector 或 both| VECTOR
    SOURCES -->|web 或 both；显式最新主动联网| WEB
    VECTOR -->|查询| VDB
    VDB -->|匹配片段| VECTOR
    KDB -->|事实 / 规则 / 行动| NORMAL
    KG -->|关系路径| NORMAL
    EM -->|情景记忆| NORMAL
    SM -->|语义记忆| NORMAL
    WM -->|工作上下文| NORMAL
    VECTOR --> NORMAL
    WEB --> NORMAL
    NORMAL --> GRADE
    GRADE --> COVER
    COVER -->|缺证据且有预算| QUERY
    COVER -->|缺玩家条件| ASK
    COVER -->|充分或预算内明确降级| BUNDLE
    BUNDLE -->|决策步骤：EvidenceBundle / context_changed| VERIFY
    BUNDLE -->|独立知识请求| SPEC

    ASK -->|needs_input| USER
    USER -->|同 task 补充回答| API
    API -->|Command resume / 原子图继续| ASK
    ASK -->|入口恢复策略| STATE
    ASK -->|步骤恢复或重规划| CHECK
    ASK -->|重新评估证据需求| QUERY

    SPEC -->|受保护结果| ASSERT
    SPEC -->|可选组织| STYLE
    STYLE -->|叙述候选| ASSERT
    ASSERT -->|通过| OUTPUT
    ASSERT -->|失败/超时| FALLBACK
    OUTPUT -->|最终答案或部分结果| USER
    FALLBACK -->|诚实降级| USER
    API -.->|保存 / 恢复| CP
    CP -.->|嵌套中断状态| ASK
    OUTPUT -.->|幂等归档| RESULTS
    API -.->|任务工作记忆| WM
    OUTPUT -.->|OutcomeEvent / memory candidates| EM
    OUTPUT -.->|偏好 / 学习更新候选| SM
    WEB -.->|正文快照| SNAP
    SNAP -.->|入库候选，审核后发布| INGEST
    INGEST -.->|不可变 release| KDB
    INGEST -.->|索引发布| VDB
    INGEST -.->|关系发布〔规划〕| KG
    API -.->|全节点 / 模型 / 工具 spans| OBS
    COVER -.->|覆盖 / 冲突 / 时效| OBS
    VERIFY -.->|计划 / 结果 / 中断| OBS
    OBS -.->|评测门禁| INGEST

    classDef deterministic fill:#e8f3ff,stroke:#2864a0,color:#12324f
    classDef generative fill:#f1eaff,stroke:#8652b3,color:#45276b
    classDef storage fill:#e8f5ef,stroke:#368265,color:#174c39
    classDef reserved fill:#fff5df,stroke:#ad7b20,color:#684710,stroke-dasharray:6 4
    class API,INGRESS,FUSION,PARSED,U_PARSE,U_STATE,STATE,U_QUERY,U_ROUTE,U_CLARIFY,ASK,SLOTS,SIMPLE_VERIFY,SIMPLE_RESULT,PREP,CHECK,EXEC,ACTION,VERIFY,FINALIZE,SOURCES,VECTOR,WEB,NORMAL,COVER,BUNDLE,INGEST,SPEC,ASSERT,OUTPUT,FALLBACK,OBS deterministic
    class TEXT,VISION,U_INTENT,PLAN,REPLAN,QUERY,GRADE,STYLE generative
    class KDB,VDB,KG,SNAP,WM,EM,SM,CP,PLAYER,RESULTS storage
    class PORTS reserved

    class READ,SAVE,OUT,USER,API,IMAGE,PARSED,ROUTE,FAST,RULES,CALC,WEB,EVIDENCE,DL,CS,AGENT,EVALUATE,RESULT,VIEW,CHECK,FINAL,EVENTS,TEST,RT,PM,DB,PROVIDER,SEARCH done
    class VLM,EXTRACT,PLAN,CHAT,COMPOSE g
    class VLM,EXTRACT,PLAN,CHAT,COMPOSE done

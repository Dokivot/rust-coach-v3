    class OUT,USER,IN,INPUT,TASK,CALC,WEB,SIMPLE,ADVICE,RENDER,LOCAL,RT,PM,DB,SEARCH done
    class PARAM,VIS,CPLAN,NARRATE,MODEL g
    class PARAM,VIS,CPLAN,NARRATE,MODEL done
    class TEXT,INTENT,QUERY,GRADE,EMBED,PLAN g
    class TEXT,INTENT,QUERY,GRADE,EMBED,PLAN planned
    class UGATE,RETRIEVE,KGATE,INGEST,KDB,EXEC,VERIFY,ASK,CP,SPEC,OUTPUT,OBS,EVAL,METRICS,PROD,OBJ d
    class UGATE,RETRIEVE,KGATE,INGEST,KDB,EXEC,VERIFY,ASK,CP,SPEC,OUTPUT,OBS,EVAL,METRICS,PROD,OBJ planned
    class FUTURE d
    class FUTURE tbd

    {
      "id": "inventory_delta",
      "category": "state",
      "steps": [
        {
          "message": "我又捡了100硫磺",
          "expected": {
            "status": "needs_input",
            "backpack": {
              "sulfur": 1000
            },
            "profile_revision": 1,
            "calls": 0
          }
        }
      ]
    },
    {
      "id": "pending_followup",
      "category": "task",
      "steps": [
        {
          "message": "拆石墙但不确定是什么服",
          "model_response": {
            "unsupported": "请确认规则"
          },
          "expected": {
            "status": "needs_input"
          }
        },
        {
          "message": "原版",
          "model_response": {
            "operation": "raid",
            "target": "building:base-wall:stone"
          },
          "expected": {
            "status": "calculated",
            "operation": "raid",
            "continues_task": true
          }
        }
      ]
    }
  ]
}

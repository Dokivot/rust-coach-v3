    R -->|"请求与历史任务"| C["检查重放资格与可用状态"]
    S[("任务、库存与已保存回答")] -->|"历史结果与有效事实"| C
    K[("固定知识发布包")] -->|"采用资格与规则"| C
    C -->|"可重放的已保存回答"| O["返回结果并展示处理进度"]
    C -->|"需要执行的任务与附件"| V{"是否需要新的图像理解"}
    V -->|"无可用观测：图片与制作目标"| M["模型提取库存候选"]
    V -->|"可用观测或本地参数"| Q["检查库存、参数与知识适用性"]
    M -->|"结构化候选；必要时有限修复"| Q
    K -->|"配方、拆除规则及版本引用"| Q
    Q -->|"证据足够：有效参数"| T["规则工具计算缺口或拆除方案"]
    Q -->|"缺少信息或证据不适用"| F["返回澄清、限制或失败"]
    M -.->|"调用失败或取消"| F
    T -->|"计算结果与依据"| B["校验并保存业务回答"]
    B -->|"任务与结果"| S
    B -->|"答案与请求标识"| O
    F -->|"原因与可执行下一步"| O
    B -.->|"符合条件时触发"| H["后台提取记忆并独立计量"]
    H -->|"通过检查的记忆"| S
    R -->|"开始与最终运行状态"| L[("本地计量记录")]
    M -->|"每次模型尝试、usage与状态"| L
    T -->|"实际阶段起止与父子关系"| L
    F -->|"已发生消耗与失败状态"| L
    B -->|"路由、业务结果状态与引用"| L
    H -->|"后台耗时、调用与原请求关联"| L
    O -.->|"用户展开详情或刷新"| D["读取本次请求及关联后台的账目"]
    L -->|"耗时、调用、覆盖率与完整性"| D
